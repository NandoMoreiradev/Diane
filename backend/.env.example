DATABASE_URL="postgresql://diane:diane_dev_password@localhost:5432/diane?schema=public"
# Produção: mínimo 32 caracteres aleatórios (ex.: openssl rand -hex 48)
JWT_SECRET="troque-esta-chave-em-producao-por-uma-string-longa-aleatoria"
# Rotação de segredo: segredos antigos ainda aceitos, separados por vírgula
JWT_SECRET_PREVIOUS=""
PORT=3001
NODE_ENV=development
# Origens extras permitidas (vazio em produção = só mesma origem; front e API vão juntos)
CORS_ORIGIN="http://localhost:5173"
# Saltos de proxy confiáveis (Cloudflare + Railway = 2). Padrão: 2 em produção, 0 em dev.
TRUST_PROXY_HOPS=
# Seed de DESENVOLVIMENTO (npm run prisma:seed)
SEED_SOCIA_PASSWORD=""
SEED_BALCAO_PASSWORD=""
# Primeiro acesso em PRODUÇÃO (lido por prisma:bootstrap; remova a senha depois do 1º deploy)
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME=""
